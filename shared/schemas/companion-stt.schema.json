{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://novamix.ai/schemas/companion-stt.json",
  "title": "NOVA Companion push-to-talk",
  "$defs": {
    "startRequest": {
      "type": "object",
      "properties": {"language": {"type": "string", "description": "'auto', 'en' or 'ar'"}}
    },
    "startResponse": {"type": "object", "required": ["listening"], "properties": {"listening": {"type": "boolean"}}},
    "stopResponse": {
      "type": "object",
      "required": ["text", "language"],
      "properties": {
        "text": {"type": "string"},
        "language": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "seconds": {"type": "number"},
        "error": {"type": "string"}
      }
    }
  }
}
